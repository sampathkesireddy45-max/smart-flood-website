# ====================================================================
# SURAKSHA-FLOOD Production Environment Variables Template
# Copy this file to .env and configure for your deployment
# ====================================================================

# Port for Uvicorn HTTP server (automatically supplied by cloud platforms)
PORT=8000

# Environment Mode: 'production' disables auto-reload; 'live' enables live APIs
ENV=production
DATA_MODE=live

# JWT Secret for session authentication tokens
JWT_SECRET=generate_a_random_32_character_string_here

# Municipal Authority Administrator Credentials
ADMIN_USERNAME=admin@floodauthority.gov.in
ADMIN_PASSWORD=SurakshaAdmin@2026
ADMIN_PHONE=9573198929

# Real SMS Gateway API Key (Fast2SMS - https://fast2sms.com)
# Requires a ₹100 recharge on Fast2SMS wallet for live carrier SMS
FAST2SMS_API_KEY=

# Optional: Twilio or 2Factor SMS Gateways
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWO_FACTOR_API_KEY=

# Optional: Frontend remote backend URL (only needed when frontend is hosted separately on Vercel/Netlify)
# VITE_BACKEND_URL=https://your-backend-service.onrender.com
